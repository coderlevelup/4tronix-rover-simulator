# Firebase Client SDK (public, safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (server-side only, DO NOT COMMIT real values).
# Used by the missions API route; the yard operator console reuses the same
# variable names, so this file can feed both.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Resend (server-side only, DO NOT COMMIT real values).
# Used by MissionNotificationService to send mission status-change emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=missions@sapient.rocks

# Sandbox only. Until a domain is verified at resend.com/domains, RESEND_FROM_EMAIL
# has to stay onboarding@resend.dev, and Resend rejects every recipient except the
# address that owns the API key. Setting this redirects all outgoing mail to that
# one permitted inbox (the intended recipient is prefixed into the subject) so the
# pipeline can be demoed end to end. Leave it UNSET once the domain is verified -
# with it set, no learner ever receives mail.
# RESEND_SANDBOX_RECIPIENT=owner_of_the_resend_account@example.com

# Base URL used to build absolute links (e.g. the "Mission Control" button)
# in outgoing emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

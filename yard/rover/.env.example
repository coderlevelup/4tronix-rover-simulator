# Yard rover server configuration.
# Copy to .env and adjust per yard. All values have sensible defaults in code.

# HTTP server port for the yard rover server (queue/add, simulate/video, health)
ROVER_SERVER_PORT=8523

# Yard type: "sim" runs the headless simulator (no hardware needed),
# "real" drives the physical 4tronix rover. Auto-detected if unset.
YARD_TYPE=sim

# Human-readable name shown against missions this yard runs (e.g. "Sim Yard",
# "Cape Town Science Center").
YARD_NAME=Local Sim Yard

# Mission Control base URL the yard polls for queued missions and uploads
# results to (Sprint 3 — yard decoupling).
MISSION_CONTROL_URL=http://localhost:3001

# Base URL of the rover/simulator HTTP endpoint the satellite forwards to.
ROVER_URL=http://marspi.local:8523

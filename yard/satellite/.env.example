# Copy to .env and fill in. Same FIREBASE_* names as mission-control's .env
# so one set of values can feed both.

# --- Rover / web server ---
ROVER_URL=http://marspi.local:8523
SATELLITE_PORT=3001
CAMERA_PORT=8890

# --- Operator console (/operator/) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three FIREBASE_* vars above: path to a service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_WEB_API_KEY=
# Optional. Unset means operator sessions reset whenever the satellite restarts.
OPERATOR_SESSION_SECRET=
# Event-day escape hatch: set to "off" to skip operator login entirely when
# venue wifi can't reach Firebase. See operator_console.py for details.
# OPERATOR_AUTH=off

# --- YouTube auto-link poll (optional; unset disables it, manual attach still works) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

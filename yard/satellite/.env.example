# Satellite web server (web_server.py)

# Rover server the satellite proxies to (and the operator console dispatches to).
ROVER_URL=http://marspi.local:8523

# --- Operator console (/operator/) ---

# Firebase service account, for Firestore (mission queue) and verifying operator
# sign-in tokens. Same variable names as mission-control/.env, so you can
# `set -a && source ../../mission-control/.env` for local dev instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json also works.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Firebase web API key for the email/password sign-in REST call.
# (NEXT_PUBLIC_FIREBASE_API_KEY is accepted too.)
FIREBASE_WEB_API_KEY=your_api_key

# Optional: stable session secret so operator logins survive server restarts.
# OPERATOR_SESSION_SECRET=generate_a_long_random_value

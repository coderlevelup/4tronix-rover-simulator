rules_version = '2';

// Mission Control / Yard security rules.
//
// Trust model: every write that creates or advances a mission goes through the
// Admin SDK - mission-control's API routes and the yard operator console - and
// the Admin SDK bypasses these rules entirely. So the browser needs far less
// access than it used to have, and anything not matched below is denied.
//
// Learner email addresses are deliberately NOT on mission documents. Missions
// are world-readable (the discovery feed lists them, and the Firebase web
// config ships in the browser bundle), and rules cannot filter fields on read,
// so anything stored on a mission is public. Missions therefore carry only
// learnerEmailHash - a one-way hash the browser can match against to find its
// own history across devices - while the address itself lives on the learner
// record, which is gettable by exact id but never listable.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOperator() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "operator";
    }

    // Keys this write would add, change or remove.
    function touchedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /rover-configs/{configId} {
      allow read, create, update, delete: if isOperator();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Missions.
    //
    // Read is public: the discovery feed and mission detail pages are meant to
    // be shared, and learners are never signed in.
    //
    // Writes: creation and every status transition go through the Admin SDK, so
    // the browser gets exactly one narrow write - stamping learnerEmailHash onto
    // a mission submitted before the learner supplied an address (see
    // LearnerContext's backfillLatestMissionEmail). It may only fill a blank,
    // never overwrite, and may touch no other field.
    //
    // The 64-char length check pins it to a sha-256 hex digest, so this write
    // cannot be used to smuggle a plaintext address onto a public document.
    match /missions/{missionId} {
      allow get, list: if true;
      allow create, delete: if false;

      allow update: if touchedKeys().hasOnly(['learnerEmailHash'])
                    && !('learnerEmailHash' in resource.data)
                    && request.resource.data.learnerEmailHash is string
                    && request.resource.data.learnerEmailHash.size() == 64
                    && request.resource.data.learnerEmailHash.matches('^[0-9a-f]{64}$');
    }

    // Mission subcollections: nothing writes these from a browser today.
    match /missions/{missionId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Learner records hold an email address and an optional display name.
    //
    // `get` is allowed so a returning browser can restore its own profile, but
    // `list` is denied so the collection cannot be enumerated - a reader has to
    // already hold the exact 21-character nanoid document id.
    //
    // Writes are restricted to the profile fields the app actually sets, so a
    // learner document cannot become arbitrary storage, and can never be
    // deleted from a browser.
    match /learners/{learnerId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;

      allow create: if request.resource.data.keys().hasOnly([
                      'id', 'sessionId', 'avatarColor', 'displayName',
                      'learnerEmail', 'missionCount', 'completedMissions',
                      'createdAt', 'lastActiveAt', 'devices',
                      'learnerId', 'missionsCompleted', 'progress'
                    ]);

      allow update: if touchedKeys().hasOnly([
                      'learnerEmail', 'displayName', 'avatarColor',
                      'lastActiveAt', 'missionCount', 'completedMissions',
                      'missionsCompleted', 'progress', 'devices'
                    ]);
    }

    match /learners/{learnerId}/{document=**} {
      allow read, write: if false;
    }
  }
}
